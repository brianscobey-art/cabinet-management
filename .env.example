# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
# Postgres (dockerized dev / production):
#   DATABASE_URL=postgresql+psycopg://cabinets:cabinets@localhost:5432/cabinets
# Local dev without Docker (default if unset): SQLite file in backend/
DATABASE_URL=sqlite:///./dev.db

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated origins allowed to call the API (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# --- Integrations (used in later phases; leave blank for Phase 0) ---
SMARTSHEET_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
ANTHROPIC_API_KEY=
