# Copy to .env for local dev. In the cloud (Render) set these as the service's
# Environment Variables instead — never commit a real .env.

# --- Core (Render sets the first two for you via render.yaml) --------------
# Postgres connection string. Leave UNSET for local dev to use the SQLite dev.db.
# Render injects this from the managed database automatically.
DATABASE_URL=
# JWT signing secret. Render auto-generates one (generateValue in render.yaml).
# Leave unset locally (a dev default is used); set a real random value in any
# shared environment. Changing it invalidates all existing logins.
SECRET_KEY=
# Where generated order/export files are written. On Render this points at the
# persistent disk (/data/generated) so files survive deploys.
GENERATED_DIR=

# --- Optional integrations -------------------------------------------------
# Domo access token (enables server-side live P&L pulls)
DOMO_ACCESS_TOKEN=

# Google Maps Platform key (Geocoding API). With it set, every Autobot address
# lookup uses Google — exact rooftop pins, knows new construction. Empty falls
# back to OpenStreetMap. console.cloud.google.com > enable "Geocoding API" >
# Credentials > Create API key. Free tier ~10k/month.
GOOGLE_MAPS_API_KEY=

# --- Feed source folders (local machine / on-prem uploader only) -----------
# The daily tracker + Vendor Suite + Century sync reads these OneDrive folders,
# which only exist where OneDrive is synced. In the cloud they won't resolve, so
# the sync just finds no files until the planned on-prem uploader (see
# CLOUD_DEPLOY.md) pushes them to object storage. Override only if folders move.
# TRACKER_DIR=
# VENDORSUITE_DIR=
# CENTURY_DIR=
# NEW_ORDERS_FILE=

# --- Cloudflare R2 (feed bridge for the cloud) -----------------------------
# Set on BOTH the cloud service and the on-prem uploader. When all four are
# present the cloud app pulls the newest feed files from R2 before each sync,
# and `python -m scripts.upload_feeds_to_r2` pushes them up from OneDrive.
# Empty = disabled (local dev reads OneDrive directly). Create in Cloudflare:
# R2 > create bucket > "Manage R2 API Tokens" > Create (Object Read & Write).
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=carter-kb-feeds
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Email invites (SendGrid) ----------------------------------------------
# Turn on "send invite" when adding a user: they get an email with a link to
# set their own password (no password is ever emailed). Set on the cloud
# service. Empty API key = invites off (admin sets a temp password instead).
# SendGrid: sendgrid.com > Settings > API Keys > Create (Mail Send). Then verify
# a From address under Settings > Sender Authentication (Single Sender is fine).
# SENDGRID_API_KEY=
# INVITE_FROM_EMAIL=no-reply@cabinettron.com   # must be a verified sender
# INVITE_FROM_NAME=Carter Kitchen and Bath
# APP_BASE_URL=https://cabinettron.com          # where the set-password link points

# --- Planned: in-app AI agent (future update, not wired yet) ---------------
# Anthropic API key for the coming assistant (custom reports, gated DB changes,
# template creation). Leave empty until that phase ships. See CLOUD_DEPLOY.md.
# ANTHROPIC_API_KEY=

# --- Order Pack (private mode inside Optimus, /ordering-platform/pack) ------
# Only these logins can load the page or hit its endpoints (comma-separated).
# ORDERPACK_OWNER_EMAILS=brian.scobey@townsendbuildingsupply.com

# Shared secret the on-prem agent authenticates with (X-Pack-Key header), same
# idea as WALLPAPER_FEED_KEY. Set the SAME value on the cloud service and on
# the PC running agent\orderpack_agent.py, then change it from the default.
# ORDERPACK_AGENT_KEY=

# Agent-side only (this PC): where the four stage folders live, how often to
# scan, and where the agent reports to.
# NEW_ORDERS_DIR=C:\Users\Brian SE6\OneDrive - carterlumber.com\Townsend Shared File\Sold Jobs\New Orders
# ORDERPACK_SCAN_MINUTES=15
# ORDERPACK_API_BASE=https://www.cabinettron.com   # canonical host; the bare domain 301s and breaks POSTs

# Auto-run stage 4 on a schedule (the way Pull_scheduled.vbs does today).
# Off by Brian's decision 8/16/26 — nothing fires unless he presses Run.
# ORDERPACK_AUTO_STAGE4=false
